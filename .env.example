# ==============================================================================
# CodeAsk Environment Configuration Template
# ==============================================================================

# LLM Reasoning Model API Key (Required)
# Used for final answer synthesis and autonomous LangGraph reasoning agent.
# Get your key from: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Embeddings API Key (Required)
# Used for code chunk embeddings via Gemini Embedding 2 (3072-dim).
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend CORS Allowed Origins (Comma-separated list of URLs)
# In production, set this to your frontend URL (e.g., https://your-app.vercel.app).
# In development, you can use http://localhost:5173 or * for wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Port (Optional, default: 8000)
# Cloud platforms like Render / Railway / Cloud Run automatically provide $PORT.
PORT=8000

# Frontend API Target (Used by Vite frontend during build/dev)
# Set to your deployed backend URL in production (e.g., https://your-backend.onrender.com)
VITE_API_URL=http://localhost:8000
